# 環境変数・鍵
.env
.env.*
!.env.example

# 一次データ（再取得可能）
data/

# 唯一の状態。GitHub Actions がデータ再取得なしでビルド/probe できるよう tdf47.sqlite はコミットする。
db/*.sqlite
db/*.sqlite3
!db/tdf47.sqlite

# 生成物
dist/

# レポート（必要に応じて個別に追加）。月次見直し用CSVは git 管理する（GitHub Actions で作られて消えないように）
reports/*
!reports/monthly-review-*.csv
!reports/link-candidates-*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# デプロイ用の接続情報
deploy/.env

# 作業用の一時ファイル
scratch_mock/

# Claude デスクトップ版の手元設定（公開しない）
.claude/
